APP_ENV=development
PORT=8080
PUBLIC_API_BASE_URL=https://api.tengenezacv.online
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tengenezacv.online,https://www.tengenezacv.online
DATABASE_URL=postgres://tengenezacv:tengenezacv@localhost:5434/tengenezacv?sslmode=disable
REDIS_URL=redis://localhost:6380/0
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=tengenezacv-api
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_PASSWORD=
CAMEL_ACCOUNTS_ISSUER=https://accounts.camelcreatives.com
CAMEL_ACCOUNTS_JWKS_URL=https://accounts.camelcreatives.com/oauth/jwks
CAMEL_ACCOUNTS_AUDIENCE=default-project-vbqshg
NGAMIA_AI_BASE_URL=https://api.ngamia.cc/v1
NGAMIA_AI_API_KEY=
MAILAFRICA_BASE_URL=https://api.mailafrica.online
MAILAFRICA_API_KEY=
MAILAFRICA_WEBHOOK_SECRET=
MAILAFRICA_FROM_DOMAIN_ID=0
MAILAFRICA_DEFAULT_FROM=noreply@mail.tengenezacv.online
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tengenezacv-exports
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
LOCAL_EXPORT_DIR=/tmp/tengenezacv-exports
LOCAL_UPLOAD_DIR=/tmp/tengenezacv-uploads
CHROMIUM_EXECUTABLE=/usr/bin/chromium
